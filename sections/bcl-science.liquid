{{ 'bcl-brand.css' | asset_url | stylesheet_tag }}

<section class="bcl-section bcl-section--off-white" aria-labelledby="BclScience-{{ section.id }}-heading">
  <div class="bcl-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bcl-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 id="BclScience-{{ section.id }}-heading" class="bcl-heading">
      {{ section.settings.heading | escape }}
    </h2>
    {%- if section.settings.lede != blank -%}
      <p class="bcl-lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}

    <div class="bcl-science__grid">
      {%- for block in section.blocks -%}
        <article class="bcl-science__card" {{ block.shopify_attributes }}>
          <p class="bcl-science__code">{{ block.settings.code | escape }}</p>
          <h3 class="bcl-science__name">{{ block.settings.name | escape }}</h3>
          <p class="bcl-science__desc">{{ block.settings.description | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BCL Science",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The peptides"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two copper-peptide complexes. Two single-purpose serums."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Copper-peptide complexes are tripeptides bound to a copper(II) ion. The deep blue is the complex itself — no dye, no fragrance."
    }
  ],
  "blocks": [
    {
      "type": "peptide",
      "name": "Peptide card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Peptide code",
          "default": "GHK-Cu"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Glycyl-L-histidyl-L-lysine, copper(II) complex"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Used in topical formulas for the appearance of firmer, smoother-looking skin. Naturally cobalt-blue in solution."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BCL Science",
      "blocks": [
        {
          "type": "peptide",
          "settings": {
            "code": "GHK-Cu",
            "name": "Glycyl-L-histidyl-L-lysine, copper(II) complex",
            "description": "Used in topical formulas for the appearance of firmer, smoother-looking skin. Naturally cobalt-blue in solution."
          }
        },
        {
          "type": "peptide",
          "settings": {
            "code": "AHK-Cu",
            "name": "Alanyl-L-histidyl-L-lysine, copper(II) complex",
            "description": "Used in topical formulas for the look of fuller, denser-appearing hair around the scalp and beard."
          }
        }
      ]
    }
  ]
}
{% endschema %}
