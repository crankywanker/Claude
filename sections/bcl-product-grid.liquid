{{ 'bcl-brand.css' | asset_url | stylesheet_tag }}

<section class="bcl-section" aria-labelledby="BclProducts-{{ section.id }}-heading">
  <div class="bcl-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bcl-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 id="BclProducts-{{ section.id }}-heading" class="bcl-heading">
      {{ section.settings.heading | escape }}
    </h2>

    <div class="bcl-products">
      {%- for block in section.blocks -%}
        {%- assign product = all_products[block.settings.product] -%}
        <a
          class="bcl-product-card"
          href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="bcl-product-card__media">
            {%- if product != blank and product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 800, 1200',
                  sizes: '(min-width: 750px) 40vw, 90vw',
                  alt: product.featured_image.alt | default: product.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <p class="bcl-product-card__code">{{ block.settings.code | escape }}</p>
          <h3 class="bcl-product-card__name">{{ block.settings.name | default: product.title | escape }}</h3>
          <p class="bcl-product-card__tag">{{ block.settings.tag | escape }}</p>
          <div class="bcl-product-card__price">
            <span>
              {%- if product != blank -%}
                {{ product.price | money }}
              {%- else -%}
                {{ block.settings.fallback_price | escape }}
              {%- endif -%}
            </span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BCL Product grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The serums"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick the molecule."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Peptide code",
          "default": "GHK-Cu"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Display name override"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Short tag",
          "default": "For the appearance of firmer-looking skin"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback price (if product unset)",
          "default": "$48"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BCL Product grid",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "code": "GHK-Cu / 01",
            "name": "GHK-Cu Serum",
            "tag": "For the appearance of firmer-looking skin",
            "fallback_price": "$48"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "code": "AHK-Cu / 02",
            "name": "AHK-Cu Serum",
            "tag": "For the look of fuller, denser-appearing hair",
            "fallback_price": "$52"
          }
        }
      ]
    }
  ]
}
{% endschema %}
